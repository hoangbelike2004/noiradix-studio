{
  "name": "pix2-language",
  "displayName": "PIX2 Language Support",
  "description": "Syntax highlighting and language configuration for PIX2 (Structured Pixel Art Language)",
  "version": "1.0.0",
  "publisher": "dotlinux26",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "pix2",
    "pixelart",
    "pixel-art",
    "gamedev",
    "syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pix2",
        "aliases": [
          "PIX2",
          "pix2"
        ],
        "extensions": [
          ".pix2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pix2",
        "scopeName": "source.pix2",
        "path": "./syntaxes/pix2.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dotlinux26/noiradix-studio"
  }
}
